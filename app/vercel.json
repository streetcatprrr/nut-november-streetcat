{
  "rewrites": [
    {
      "source": "/donate",
      "destination": "/index.html"
    },
    {
      "source": "/clinic",
      "destination": "/index.html"
    },
    {
      "source": "/streetcat",
      "destination": "/index.html"
    },
    {
      "source": "/status",
      "destination": "/status.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https: wss:; font-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
